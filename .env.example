# 复制此文件为 .env.local 或对应环境配置后修改
# Vite 环境变量必须以 VITE_ 前缀开头

# API 基础地址
# - 开发环境（MSW 启用）：/api（由 MSW 拦截）
# - 开发环境（MSW 关闭）：/api（由 vite.config.ts proxy 转发至 VITE_API_PROXY_TARGET）
# - 生产环境：/api（由部署环境的反向代理转发至真实后端）
VITE_API_BASE_URL=/api

# 是否启用 MSW（Mock Service Worker）
# - true：使用内置 mock 数据（开发默认）
# - false：请求真实后端（联调/生产）
VITE_ENABLE_MSW=true

# 开发环境下 MSW 关闭时的代理目标（仅 dev 生效，生产环境由反向代理处理）
# 示例：http://localhost:8080 或 https://your-backend.example.com
VITE_API_PROXY_TARGET=http://localhost:8080

# Sentry DSN（可选，留空则不启用错误上报）
# 获取方式：https://sentry.io/ → 项目设置 → Client Keys
VITE_SENTRY_DSN=

# AI 后端选择（Task 15）
# - local（默认）：本地规则引擎，离线/演示/降级兜底，不调用外部接口
# - remote：调用远程 AI 接口（需部署后端 /api/ai/* 端点，且默认需用户确认后才发送数据）
VITE_AI_BACKEND=local

# 远程 AI 接口基础路径（相对 VITE_API_BASE_URL，默认 /ai）
VITE_AI_BACKEND_URL=/ai

# 远程 AI 单次请求超时（毫秒，默认 15000）
VITE_AI_TIMEOUT_MS=15000

# 远程 AI 客户端限流：每分钟最大请求数（默认 30）
VITE_AI_RATE_LIMIT=30

# 远程 AI 失败时是否允许回退到本地规则引擎（默认 true；设为 false 则远程失败即判定为 AI 不可用）
VITE_AI_FALLBACK_LOCAL=true

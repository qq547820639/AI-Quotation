# ============================================================
# 生产环境一键部署配置模板（P0-2 / P0-5）
# 复制为项目根 .env 并填写真实值：cp .env.production.example .env
# 密钥必须通过环境变量注入，请勿提交到仓库。
#
# 安全密钥生成命令（任选其一）：
#   openssl rand -hex 32
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# 或：  cd backend && python -m app.scripts.generate_secrets
# ============================================================

# ---- 运行环境（生产固定 prod）----
APP_ENV=prod
APP_DEMO_MODE=false

# ---- PostgreSQL（生产必须注入强密码）----
POSTGRES_USER=procurement
POSTGRES_PASSWORD=CHANGEME_STRONG_DB_PASSWORD
POSTGRES_DB=procurement

# ---- 后端签名/加密密钥（生产必须为随机强密钥，长度 >= 32）----
# 后端启动时会校验：仍为默认/过短密钥时拒绝启动（fail-fast）。
SECRET_KEY=CHANGEME_OPENSSL_RAND_HEX_64_CHARS

# ---- CORS 白名单（生产必须配置实际域名，禁止仅 localhost）----
# 支持 JSON 数组或逗号分隔两种格式。
CORS_ORIGINS=["https://procurement.example.com","https://admin.example.com"]

# ---- 公开应用地址（供应商邀请链接 canonical，生产必须 HTTPS 且非 localhost）----
PUBLIC_APP_URL=https://procurement.example.com

# ---- 安全响应头（生产开启）----
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# 可信反向代理地址（前置 nginx/负载均衡器 IP，逗号分隔）
TRUSTED_PROXY=

# ---- 通知渠道（生产必须 email；禁 log/mailpit/none）----
NOTIFY_CHANNEL=email
SMTP_HOST=CHANGEME.smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=CHANGEME_SMTP_USER
SMTP_PASSWORD=CHANGEME_SMTP_PASSWORD
SMTP_FROM=no-reply@example.com
SMTP_USE_TLS=true

# ---- 对象存储（S3/MinIO，生产建议自建或托管 S3）----
S3_ENDPOINT=http://minio:9000
S3_BUCKET=procurement-attachments
S3_ACCESS_KEY=CHANGEME_MINIO_USER
S3_SECRET_KEY=CHANGEME_MINIO_PASSWORD

# ---- 病毒扫描（生产必须 clamav，禁 noop）----
SCANNER_PROVIDER=clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30
SCAN_FAIL_OPEN=false

# ---- Redis（docker-compose 内置）----
REDIS_URL=redis://redis:6379/0

# ---- 持久化任务队列（Celery，P0-5）----
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_MAX_RETRIES=3
CELERY_TASK_RETRY_BACKOFF=true
CELERY_TASK_RETRY_BACKOFF_MAX=60

# ---- worker/dispatcher/beat 调优（P0-5）----
CELERY_LOG_LEVEL=INFO
CELERY_WORKER_CONCURRENCY=4
CELERY_QUEUE_NAME=procurement
CELERY_TASK_SOFT_TIME_LIMIT=300
CELERY_TASK_TIME_LIMIT=600
OUTBOX_POLL_INTERVAL_SECONDS=5

# ---- AI 服务（可选；默认 local 不调用外部 API）----
# AI_PROVIDER=remote
# AI_API_KEY=CHANGEME
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# ---- 对象存储/扫描探活调优（可选）----
S3_REQUIRED=true
CLAMAV_REQUIRED=true
REDIS_REQUIRED=true
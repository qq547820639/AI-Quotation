# ============================================================
# 后端环境变量示例（复制为 backend/.env 或通过 docker-compose
# environment 注入）。请勿提交真实密钥到仓库。
# ============================================================

# ---- 运行环境 ----
# dev / test / prod
# APP_ENV=prod 时默认 DB_AUTO_CREATE=false（生产依赖 Alembic 迁移建表）
APP_ENV=dev

# ---- 数据库 ----
# 生产：PostgreSQL（psycopg2 驱动，自动启用连接池）
# DATABASE_URL=postgresql://procurement:CHANGE_ME@localhost:5432/procurement
# 开发/演示：SQLite（不设置 DATABASE_URL 时回退到 sqlite:///<DB_PATH>）
# DB_PATH=./procurement.db

# 是否由应用启动时 create_all（dev/test 默认 true；prod 强制 false）
DB_AUTO_CREATE=true

# PostgreSQL 连接池（仅 DATABASE_URL 含 postgresql:// 时生效）
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_PRE_PING=true

# ---- 认证与安全 ----
# 生产必须设置为随机强密钥（例如：python -c "import secrets; print(secrets.token_urlsafe(64))"）
SECRET_KEY=dev-secret-key-change-me
# 演示模式：仅开发/演示开启（快捷登录，免密码）。生产必须 false
APP_DEMO_MODE=false
# 演示账号默认密码（仅 APP_DEMO_MODE=true 时种子用户使用）
DEMO_USER_PASSWORD=123456

# ---- 会话 ----
TOKEN_TTL=86400
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=1209600
LOGIN_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW=900

# ---- Redis（可选，设置后使用 Redis 会话/限流；留空用进程内实现） ----
# REDIS_URL=redis://localhost:6379/0

# ---- 安全响应头（可选） ----
# HSTS_ENABLED=true
# CSP_DEFAULT=default-src 'self'; ...
# REFERRER_POLICY=strict-origin-when-cross-origin
# PERMISSIONS_POLICY=camera=(), microphone=(), geolocation=(), payment=()

# ---- 供应商邀请 / 附件 ----
INVITATION_TOKEN_TTL_HOURS=72
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE=10485760

# ---- 附件存储（S3/MinIO，可选；未配置自动回退本地 UPLOAD_DIR） ----
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=procurement-attachments
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin

# ---- Cookie / 反向代理 ----
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# 可信反向代理地址（逗号分隔），用于信任 X-Forwarded-* 头
TRUSTED_PROXY=
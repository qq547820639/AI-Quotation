# 前端多阶段构建：Node 构建 → Nginx 运行
# node:20 已于 2025-04 停止维护（EOL），存在持续累计的 HIGH/CRITICAL 基础镜像 CVE；
# 升级到与 CI 运行一致的 node:24（LTS 维护线），构建产物运行在独立的 nginx:alpine 运行态。
FROM node:24-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN VITE_ENABLE_MSW=false VITE_API_BASE_URL=/api npm run build

FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
